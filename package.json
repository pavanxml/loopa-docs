{
  "name": "loopa-docs",
  "version": "1.0.0",
  "private": true,
  "description": "The LOOPA handbook: searchable, responsive static documentation.",
  "scripts": {
    "dev": "node docs-site/serve.mjs --watch",
    "build": "node docs-site/build.mjs",
    "preview": "node docs-site/serve.mjs",
    "test": "playwright test --config playwright.docs.config.ts",
